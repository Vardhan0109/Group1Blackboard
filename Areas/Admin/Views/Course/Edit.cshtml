
@model Group1Blackboard.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<h2>Edit Course</h2>

<form asp-area="Admin" asp-controller="Course"
      asp-action="Edit" method="post">

    <input type="hidden" asp-for="CourseID" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CourseNumber" class="form-label"></label>
        <input asp-for="CourseNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CourseName" class="form-label"></label>
        <input asp-for="CourseName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Credit" class="form-label"></label>
        <input asp-for="Credit" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="OfferedSemester" class="form-label">Semester</label>
        
<select asp-for="OfferedSemester"
        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Group1Blackboard.Models.Course.Semesters))"
        class="form-select">
    <option value="">Select Semester</option>
</select>

    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        
<select asp-for="Location"
        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Group1Blackboard.Models.Course.Locations))"
        class="form-select">
    <option value="">Select Location</option>
</select>

    </div>

    <div class="mb-3">
        <label asp-for="Times" class="form-label"></label>
        <input asp-for="Times" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ShortDescription" class="form-label">Description</label>
        <textarea asp-for="ShortDescription"
                  class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="MajorID" class="form-label">Major</label>
        <select asp-for="MajorID" asp-items="ViewBag.Majors"
                class="form-select">
            <option value="">Select Major</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="InstructorID" class="form-label">Instructor</label>
        <select asp-for="InstructorID" asp-items="ViewBag.Instructors"
                class="form-select">
            <option value="">Not Assigned</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

    <a asp-area="Admin" asp-controller="Course"
       asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
