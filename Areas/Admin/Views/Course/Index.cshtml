
@model List<Group1Blackboard.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<h2>Course Management</h2>

<a asp-area="Admin" asp-controller="Course"
   asp-action="Add" class="btn btn-primary mb-3">
    Add Course
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course Number</th>
            <th>Course Name</th>
            <th>Credit</th>
            <th>Semester</th>
            <th>Location</th>
            <th>Times</th>
            <th>Instructor</th>
            <th>Major</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.CourseNumber</td>
                <td>@course.CourseName</td>
                <td>@course.Credit</td>
                <td>@course.OfferedSemester</td>
                <td>@course.Location</td>
                <td>@course.Times</td>
                <td>@(course.Instructor?.Name ?? "Not Assigned")</td>
                <td>@course.Major?.Name</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@course.CourseID"
                       class="btn btn-primary btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@course.CourseID"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
