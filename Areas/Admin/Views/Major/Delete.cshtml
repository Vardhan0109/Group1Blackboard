
@model Group1Blackboard.Models.Major

@{
    ViewData["Title"] = "Delete Major";
}

<h2>Delete Major</h2>

<p>Are you sure you want to delete this major?</p>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>College:</strong> @Model.College</p>

<form asp-area="Admin" asp-controller="Major"
      asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="MajorID" name="id" />

    <button type="submit" class="btn btn-danger">Delete</button>

    <a asp-area="Admin" asp-controller="Major"
       asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
