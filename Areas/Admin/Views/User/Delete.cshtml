
@model Group1Blackboard.Models.AppUser

@{
    ViewData["Title"] = "Delete User";
}

<h2>Delete User</h2>

<p>Are you sure you want to delete this user?</p>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Role:</strong> @Model.Role</p>

<form asp-area="Admin" asp-controller="User"
      asp-action="DeleteConfirmed" method="post">

    <input type="hidden" name="id" value="@Model.AppUserID" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-area="Admin" asp-controller="User"
       asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
