
@model Group1Blackboard.Models.CourseCatalogViewModel

@{
    ViewData["Title"] = "Course Catalog";
}

<h2>Course Catalog</h2>

<p>Browse available courses and filter by major, semester, or location.</p>

<form asp-controller="Course" asp-action="Index" method="get"
      class="row g-3 mb-4">

    <div class="col-md-4">
        <label class="form-label">Major</label>
        <select name="majorID" class="form-select">
            <option value="">All Majors</option>

            @foreach (var major in Model.Majors)
            {
                if (Model.SelectedMajorID == major.MajorID)
                {
                    <option value="@major.MajorID" selected>
                        @major.Name
                    </option>
                }
                else
                {
                    <option value="@major.MajorID">
                        @major.Name
                    </option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Semester</label>
        <select name="semester" class="form-select">
            <option value="All">All Semesters</option>

            @foreach (var semester in Group1Blackboard.Models.Course.Semesters)
            {
                if (Model.SelectedSemester == semester)
                {
                    <option value="@semester" selected>@semester</option>
                }
                else
                {
                    <option value="@semester">@semester</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Location</label>
        <select name="location" class="form-select">
            <option value="All">All Locations</option>

            @foreach (var location in Group1Blackboard.Models.Course.Locations)
            {
                if (Model.SelectedLocation == location)
                {
                    <option value="@location" selected>@location</option>
                }
                else
                {
                    <option value="@location">@location</option>
                }
            }
        </select>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">
            Filter Courses
        </button>

        <a asp-controller="Course" asp-action="Index"
           class="btn btn-secondary">
            Clear Filters
        </a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course Number</th>
            <th>Course Name</th>
            <th>Major</th>
            <th>Semester</th>
            <th>Location</th>
            <th>Credits</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var course in Model.Courses)
        {
            <tr>
                <td>@course.CourseNumber</td>
                <td>@course.CourseName</td>
                <td>@course.Major?.Name</td>
                <td>@course.OfferedSemester</td>
                <td>@course.Location</td>
                <td>@course.Credit</td>
                <td>
                    <a asp-controller="Course"
                       asp-action="Details"
                       asp-route-id="@course.CourseID"
                       class="btn btn-sm btn-primary">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Courses.Any())
{
    <p>No courses match your selected filters.</p>
}
